{
  "name": "@devos/isolation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevOS per-stack network and resource isolation, the DevOS side (S4-a, F3): subnet derivation, Compose hardening, the afterStack hook.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
