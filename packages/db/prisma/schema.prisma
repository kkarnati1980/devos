// DevOS data model — M1.1 (docs/modules/M1.1.md). Version 1.0.0.
// Conventions (M1.1-d/e): uuid PKs generated by Postgres, timestamptz, money numeric(12,6) USD,
// snake_case tables/columns, Postgres enums, every FK ON DELETE RESTRICT and indexed.
// Checks, triggers and other objects Prisma does not model live in the raw-SQL migration
// `prisma/migrations/*_integrity/migration.sql`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum ProjectStage {
  intake
  provisioning
  building
  preview
  live
  archived
  purged

  @@map("project_stage")
}

enum SpecFormat {
  docx
  pdf
  md
  html
  paste

  @@map("spec_format")
}

enum RequirementsDocStatus {
  draft
  approved
  superseded

  @@map("requirements_doc_status")
}

enum Priority {
  must
  should
  could

  @@map("priority")
}

enum ModuleStatus {
  planned
  ready
  in_progress
  in_review
  merged
  deadlocked

  @@map("module_status")
}

enum TaskKind {
  build
  test
  review
  fix
  maintenance
  human

  @@map("task_kind")
}

enum Assignee {
  agent
  kk
  engineer

  @@map("assignee")
}

enum TaskStatus {
  blocked
  ready
  running
  done
  failed
  deadlocked

  @@map("task_status")
}

enum Role {
  chief
  analyst
  architect
  builder
  tester
  reviewer
  release
  maintainer

  @@map("role")
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  limit_hit
  cancelled

  @@map("run_status")
}

enum Provider {
  anthropic
  openai

  @@map("provider")
}

enum CheckKind {
  build
  lint
  typecheck
  unit
  acceptance
  smoke

  @@map("check_kind")
}

enum Reviewer {
  codex
  opus_tiebreak

  @@map("reviewer")
}

enum Verdict {
  pass
  changes_requested

  @@map("verdict")
}

enum Severity {
  high
  medium
  low

  @@map("severity")
}

enum Environment {
  preview
  live

  @@map("environment")
}

enum DeployStatus {
  pending
  deploying
  probation
  succeeded
  failed
  rolled_back

  @@map("deploy_status")
}

enum Gate {
  requirements
  decision
  first_launch
  destructive_or_spend
  purge

  @@map("gate")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired

  @@map("approval_status")
}

enum ResourceProvider {
  github
  coolify
  cloudflare
  r2
  vault
  backup_schedule

  @@map("resource_provider")
}

enum ResourceStatus {
  active
  deleted

  @@map("resource_status")
}

enum ChannelKind {
  dashboard
  mybrain
  email

  @@map("channel_kind")
}

enum MemoryType {
  decision
  observation
  checkpoint
  evidence

  @@map("memory_type")
}

enum Actor {
  agent
  kk
  system

  @@map("actor")
}

enum NotificationStatus {
  pending
  sent
  failed

  @@map("notification_status")
}

enum ReportKind {
  morning
  weekly

  @@map("report_kind")
}

// ---------- project and plan ----------

model Project {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String       @unique
  name         String
  stage        ProjectStage @default(intake)
  pausedAt     DateTime?    @map("paused_at") @db.Timestamptz(6)
  capUsd       Decimal      @default(15) @map("cap_usd") @db.Decimal(12, 6)
  lanes        Int          @default(2)
  repoUrl      String?      @map("repo_url")
  importedRepo Boolean      @default(false) @map("imported_repo")
  previewUrl   String?      @map("preview_url")
  liveUrl      String?      @map("live_url")
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(6)
  purgeAfter   DateTime?    @map("purge_after") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  specs           Spec[]
  requirementDocs RequirementsDoc[]
  requirements    Requirement[]
  milestones      Milestone[]
  modules         Module[]
  tasks           Task[]
  runs            Run[]
  costEntries     CostEntry[]
  commits         Commit[]
  deploys         Deploy[]
  healthChecks    HealthCheck[]
  approvals       Approval[]
  resources       Resource[]
  vaultSecrets    VaultSecret[]
  memoryItems     MemoryItem[]
  auditEvents     AuditEvent[]

  @@map("project")
}

model Spec {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  version      Int
  sourceFormat SpecFormat @map("source_format")
  originalName String?    @map("original_name")
  fileSha256   String?    @map("file_sha256")
  storagePath  String?    @map("storage_path")
  text         String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@map("spec")
}

model RequirementsDoc {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String                @map("project_id") @db.Uuid
  version    Int
  repoPath   String                @map("repo_path")
  commitSha  String?               @map("commit_sha")
  status     RequirementsDocStatus @default(draft)
  approvalId String?               @map("approval_id") @db.Uuid
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approval Approval? @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([approvalId])
  @@map("requirements_doc")
}

model Requirement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  key         String
  title       String
  priority    Priority
  acceptance  String
  milestoneId String?  @map("milestone_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone     Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  modules       ModuleRequirement[]
  tasks         TaskRequirement[]
  testEvidences TestEvidence[]

  @@unique([projectId, key])
  @@index([milestoneId])
  @@map("requirement")
}

model Milestone {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  ordinal        Int
  name           String
  gateName       String    @map("gate_name")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  gateApprovalId String?   @map("gate_approval_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  gateApproval Approval?     @relation(fields: [gateApprovalId], references: [id], onDelete: Restrict)
  requirements Requirement[]
  modules      Module[]

  @@unique([projectId, ordinal])
  @@index([gateApprovalId])
  @@map("milestone")
}

model Module {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  milestoneId  String       @map("milestone_id") @db.Uuid
  key          String
  title        String
  lane         Int
  contractPath String       @map("contract_path")
  status       ModuleStatus @default(planned)
  mergedSha    String?      @map("merged_sha")
  linearIssue  String?      @map("linear_issue")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone    Milestone           @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  dependsOn    ModuleDependency[]  @relation("dependent")
  dependents   ModuleDependency[]  @relation("dependency")
  requirements ModuleRequirement[]
  tasks        Task[]
  commits      Commit[]

  @@unique([projectId, key])
  @@index([milestoneId])
  @@map("module")
}

model ModuleDependency {
  moduleId    String @map("module_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  module    Module @relation("dependent", fields: [moduleId], references: [id], onDelete: Restrict)
  dependsOn Module @relation("dependency", fields: [dependsOnId], references: [id], onDelete: Restrict)

  @@id([moduleId, dependsOnId])
  @@index([dependsOnId])
  @@map("module_dependency")
}

model ModuleRequirement {
  moduleId      String @map("module_id") @db.Uuid
  requirementId String @map("requirement_id") @db.Uuid

  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@id([moduleId, requirementId])
  @@index([requirementId])
  @@map("module_requirement")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  moduleId    String?    @map("module_id") @db.Uuid
  kind        TaskKind
  assignee    Assignee   @default(agent)
  title       String
  status      TaskStatus @default(ready)
  attempts    Int        @default(0)
  linearIssue String?    @map("linear_issue")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  requirements     TaskRequirement[]
  blockers         TaskBlocker[]
  runs             Run[]
  followUpFindings ReviewFinding[]
  memoryItems      MemoryItem[]

  @@index([projectId, status])
  @@index([moduleId])
  @@map("task")
}

model TaskRequirement {
  taskId        String @map("task_id") @db.Uuid
  requirementId String @map("requirement_id") @db.Uuid

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@id([taskId, requirementId])
  @@index([requirementId])
  @@map("task_requirement")
}

model TaskBlocker {
  taskId     String @map("task_id") @db.Uuid
  approvalId String @map("approval_id") @db.Uuid

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@id([taskId, approvalId])
  @@index([approvalId])
  @@map("task_blocker")
}

// ---------- runs and cost ----------

model Run {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  role       Role
  model      String
  attempt    Int       @default(1)
  status     RunStatus @default(queued)
  maxTurns   Int       @map("max_turns")
  maxSeconds Int       @map("max_seconds")
  maxCostUsd Decimal   @map("max_cost_usd") @db.Decimal(12, 6)
  turns      Int       @default(0)
  startSha   String?   @map("start_sha")
  endSha     String?   @map("end_sha")
  branch     String?
  error      String?
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  checkpoints Checkpoint[]
  costEntries CostEntry[]

  @@index([taskId])
  @@index([projectId, status])
  @@map("run")
}

model Checkpoint {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, seq])
  @@map("checkpoint")
}

model CostEntry {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String?  @map("project_id") @db.Uuid
  runId            String?  @map("run_id") @db.Uuid
  reviewVerdictId  String?  @map("review_verdict_id") @db.Uuid
  provider         Provider
  model            String
  role             Role
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  usd              Decimal  @db.Decimal(12, 6)
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  run           Run?           @relation(fields: [runId], references: [id], onDelete: Restrict)
  reviewVerdict ReviewVerdict? @relation(fields: [reviewVerdictId], references: [id], onDelete: Restrict)

  @@index([projectId, occurredAt])
  @@index([runId])
  @@index([reviewVerdictId])
  @@map("cost_entry")
}

// ---------- code, tests, review, deploys ----------

model Commit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  sha       String
  branch    String?
  moduleId  String?  @map("module_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  module        Module?         @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  testEvidences TestEvidence[]
  verdicts      ReviewVerdict[]
  deploys       Deploy[]

  @@unique([projectId, sha])
  @@index([moduleId])
  @@map("commit")
}

model TestEvidence {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commitId      String    @map("commit_id") @db.Uuid
  check         CheckKind
  requirementId String?   @map("requirement_id") @db.Uuid
  command       String
  exitCode      Int       @map("exit_code")
  passed        Boolean
  outputRef     String?   @map("output_ref")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  commit      Commit       @relation(fields: [commitId], references: [id], onDelete: Restrict)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@index([commitId])
  @@index([requirementId])
  @@map("test_evidence")
}

model ReviewVerdict {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commitId  String   @map("commit_id") @db.Uuid
  round     Int
  reviewer  Reviewer
  verdict   Verdict
  summary   String
  raw       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  commit      Commit          @relation(fields: [commitId], references: [id], onDelete: Restrict)
  findings    ReviewFinding[]
  deploys     Deploy[]
  costEntries CostEntry[]

  @@unique([commitId, round])
  @@map("review_verdict")
}

model ReviewFinding {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewVerdictId String   @map("review_verdict_id") @db.Uuid
  severity        Severity
  file            String
  line            Int
  evidence        String
  consequence     String
  followUpTaskId  String?  @map("follow_up_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewVerdict ReviewVerdict @relation(fields: [reviewVerdictId], references: [id], onDelete: Restrict)
  followUpTask  Task?         @relation(fields: [followUpTaskId], references: [id], onDelete: Restrict)

  @@index([reviewVerdictId])
  @@index([followUpTaskId])
  @@map("review_finding")
}

model Deploy {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  commitId          String       @map("commit_id") @db.Uuid
  environment       Environment
  status            DeployStatus @default(pending)
  reviewVerdictId   String?      @map("review_verdict_id") @db.Uuid
  approvalId        String?      @map("approval_id") @db.Uuid
  coolifyDeployment String?      @map("coolify_deployment")
  rolledBackToId    String?      @map("rolled_back_to_id") @db.Uuid
  startedAt         DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  commit          Commit         @relation(fields: [commitId], references: [id], onDelete: Restrict)
  reviewVerdict   ReviewVerdict? @relation(fields: [reviewVerdictId], references: [id], onDelete: Restrict)
  approval        Approval?      @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  rolledBackTo    Deploy?        @relation("rollback", fields: [rolledBackToId], references: [id], onDelete: Restrict)
  rollbacksOfThis Deploy[]       @relation("rollback")

  @@index([projectId, environment, createdAt])
  @@index([commitId])
  @@index([reviewVerdictId])
  @@index([approvalId])
  @@index([rolledBackToId])
  @@map("deploy")
}

model HealthCheck {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  environment Environment
  ok          Boolean
  latencyMs   Int?        @map("latency_ms")
  checkedAt   DateTime    @default(now()) @map("checked_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, environment, checkedAt])
  @@map("health_check")
}

// ---------- approvals, inventory, settings, secrets ----------

model Approval {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String?        @map("project_id") @db.Uuid
  gate             Gate
  action           String
  target           String
  reason           String
  costUsd          Decimal?       @map("cost_usd") @db.Decimal(12, 6)
  consequence      String?
  status           ApprovalStatus @default(pending)
  decidedAt        DateTime?      @map("decided_at") @db.Timestamptz(6)
  decidedBy        String?        @map("decided_by")
  confirmationHash String?        @map("confirmation_hash")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  project         Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  comments        ApprovalComment[]
  requirementDocs RequirementsDoc[]
  gatedMilestones Milestone[]
  blockedTasks    TaskBlocker[]
  deploys         Deploy[]
  notifications   Notification[]

  @@index([projectId, status])
  @@index([status, createdAt])
  @@map("approval")
}

model ApprovalComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalId String   @map("approval_id") @db.Uuid
  author     String
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@index([approvalId])
  @@map("approval_comment")
}

model Resource {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  provider   ResourceProvider
  kind       String
  externalId String           @map("external_id")
  name       String
  status     ResourceStatus   @default(active)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([provider, kind, externalId])
  @@index([projectId, status])
  @@map("resource")
}

model AppSettings {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton            Boolean  @unique @default(true)
  anthropicCapUsd      Decimal  @default(15) @map("anthropic_cap_usd") @db.Decimal(12, 6)
  openaiCapUsd         Decimal  @default(15) @map("openai_cap_usd") @db.Decimal(12, 6)
  defaultProjectCapUsd Decimal  @default(15) @map("default_project_cap_usd") @db.Decimal(12, 6)
  probationMinutes     Int      @default(15) @map("probation_minutes")
  archiveDays          Int      @default(30) @map("archive_days")
  defaultLanes         Int      @default(2) @map("default_lanes")
  maxLanes             Int      @default(3) @map("max_lanes")
  reportTime           String   @default("08:00") @map("report_time")
  timezone             String   @default("Asia/Kolkata")
  auditRetentionMonths Int      @default(12) @map("audit_retention_months")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model RoleModel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role      Role     @unique
  model     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("role_model")
}

model NotificationChannel {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      ChannelKind @unique
  enabled   Boolean     @default(true)
  target    String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_channel")
}

model VaultSecret {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  name       String
  ciphertext Bytes
  nonce      Bytes
  keyVersion Int      @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, name])
  @@map("vault_secret")
}

// ---------- memory, audit, notifications, reports ----------

model MemoryItem {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String     @map("project_id") @db.Uuid
  taskId     String?    @map("task_id") @db.Uuid
  type       MemoryType
  content    String
  source     String
  observedAt DateTime   @map("observed_at") @db.Timestamptz(6)
  verifiedAt DateTime?  @map("verified_at") @db.Timestamptz(6)
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([projectId, type])
  @@index([taskId])
  @@map("memory_item")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor      Actor
  role       Role?
  projectId  String?  @map("project_id") @db.Uuid
  sha        String?
  costUsd    Decimal? @map("cost_usd") @db.Decimal(12, 6)
  action     String
  summary    String
  details    Json?

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, occurredAt])
  @@index([occurredAt])
  @@map("audit_event")
}

model Notification {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalId String?            @map("approval_id") @db.Uuid
  channel    ChannelKind
  status     NotificationStatus @default(pending)
  attempts   Int                @default(0)
  sentAt     DateTime?          @map("sent_at") @db.Timestamptz(6)
  error      String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  approval Approval? @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@index([approvalId])
  @@index([status, createdAt])
  @@map("notification")
}

model Report {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        ReportKind
  periodStart DateTime   @map("period_start") @db.Timestamptz(6)
  body        String
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, periodStart])
  @@map("report")
}
