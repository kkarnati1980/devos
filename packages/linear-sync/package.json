{
  "name": "@devos/linear-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevOS Linear sync (M2.6): GraphQL client with timeouts and safe retries, idempotent DevOS -> Linear mirror (D10).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "test:db": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"test-db/*.test.mjs\""
  },
  "devDependencies": {
    "@devos/db": "workspace:*",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3"
  }
}
